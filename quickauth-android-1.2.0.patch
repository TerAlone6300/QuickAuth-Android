+    }
+
+    @Test fun unpackReadsPythonPackedAccounts() {
+        val un = E2ee.unpack(master, pythonPacked)
+        assertEquals(accounts, un.accounts)
+        assertTrue(un.legacy.isEmpty())
+        assertEquals(0, un.undecryptable)
+    }
+
+    @Test fun packProducesTheSameSlotsAsPython() {
+        val mine = E2ee.pack(master, accounts)
+        assertEquals(pythonPacked.keys, mine.keys)
+        assertEquals(accounts, E2ee.unpack(master, mine).accounts)
+    }
+
+    @Test fun rejectsForgedWrongKeyAndMalformedBlobs() {
+        val good = "e1:44A7GlxuYClMu5qOqfoyaX1m6U5fLYV4xnlAjyVlU_huW9LWLonleR5lh2NKQSITAWzamzM="
+        assertNull(E2ee.open(master, good.dropLast(4) + (if (good[good.length - 4] == 'A') "BBBB" else "AAAA"), "slot".toByteArray()))
+        assertNull("sealed with another key", E2ee.open(master, "e1:WPdw3fAawNmnLhYCe3cCt2rUiOmT2d6Nz4t1zaOYTWgc1ESTTYovcaHXrhqgMc0oJQ==", ByteArray(0)))
+        for (bad in listOf(null, "", "x", "e1:", "e1:AAAA", "e1:!!!!")) assertNull(E2ee.open(master, bad, ByteArray(0)))
+        assertFalse(E2ee.verifyCheck(ByteArray(32), "e1:9xfyU8zpJ17REPd_W54hQ02Z8HjxMs6T48XIaFQhMaa3R8_FIW7Tc9Xhb_fR5LA0IcgFe84evsBm2YyGoxPLj0Sr0Pg="))
+    }
+
+    @Test fun hostileServerDataIsNotAccepted() {
+        val data = LinkedHashMap<String, String?>(pythonPacked)
+        data["__sync_url__"] = "http://evil.example"      // config key: ignored
+        data["plain"] = "PLAINSECRET"                      // unencrypted entry: reported as legacy, never trusted
+        data["gone"] = null
+        data["e1.aa"] = "e1:-RKiEAGwhmg1rGtHlcewwjB_EvZPyGYWYDhJuzHaprQl8_JK667Grnv9vJIsKwJ7S2M6BRmteCsmArj834Atc0Pd6ezfIp9KRghdf0a5xSLmAv_i5HVM9jI="                         // authentic, but claims the name "__sync_url__"
+        data["e1.bb"] = "e1:FU4KtUifkAwgVelnHq-F6Zb_1B4DW_OU4g4JmEOPmykqhnVpxVSHBUdtKUVBlyfuLsMoLrHStr2VyhQSAdDehlwysa6BxHSQ2Y5TOdM="                         // authentic, but the name contains an ANSI escape
+        val un = E2ee.unpack(master, data)
