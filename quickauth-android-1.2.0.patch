+package asia.axientstudio.quickauth.android.crypto
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Interoperability vectors generated by the Python client (teralone_auth.py >= 1.9.1). If one of these fails, the
+ * Android app and the Python client can no longer read each other's synced data: do NOT "fix" it by changing the
+ * expected values.
+ */
+class E2eeTest {
+    private fun hex(s: String) = ByteArray(s.length / 2) { s.substring(it * 2, it * 2 + 2).toInt(16).toByte() }
+    private fun hx(b: ByteArray) = b.joinToString("") { String.format("%02x", it.toInt() and 0xFF) }
+
+    private val master = hex("fd18ed57ad4fa5c0614cacea8a731fc9b5e3affe37138b39d9ab17bd77f608ab")
+    private val accounts = mapOf(
+            "GitHub" to "JBSWY3DPEHPK3PXP",
+            "Google" to "GEZDGNBVGY3TQOJQ",
+            "Caf\u00e9 \u2713 \ud83d\ude00" to "S3CR3T\u00e9 \"q\" \\ x"
+    )
+    private val pythonPacked = mapOf(
+            "e1.bfa880457ad6a48d49db5def6d174877" to "e1:plWlKZA0MrNn_2LqKjQBFx4uClxjnq-mJboq0cOMgBfYA-3SKsrEryDFZga1XwkVBaXpuY90RkGOpGzchJHzbVrvyaD6IX24dZS5_6NLnL7t2rgTkAdy1g==",
+            "e1.24ce4466127be2a43ceea3854df3a311" to "e1:nicugkgFIqOBQvLqWjqpYSYFlhcYB3cMdQa9BANgVhmY85qVFQS-9Z0_pcE_HHZHvuA8cchuhLjBaC5o_HsZCsM9kC4M2a6tRUb2uS6VBR5J_6Hg5lnemQ==",
+            "e1.15eaa7891f0e07bc897b9dfb57d5ae93" to "e1:U8OJ8TVz8LoPKFT1JYb4tggLupZr1KfDEVLr-0Drnj-CBydnXvRI9qmN3L5yUbHVFGZIxtJCaF5f_xwVxQJaZ-WZNfJhscTwFcxVyMCwIpDMhP-wQzfnifCaTZGDBI0-qVKVGRYpcwET_5n_glc-FX1R6jtAyg=="
+    )
+
+    @Test fun pbkdf2MatchesStandardVectors() {
+        assertEquals("120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
+            hx(E2ee.pbkdf2HmacSha256("password".toByteArray(), "salt".toByteArray(), 1)))
+        assertEquals("c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a",
+            hx(E2ee.pbkdf2HmacSha256("password".toByteArray(), "salt".toByteArray(), 4096)))
+    }
+
+    @Test fun deriveMatchesPythonForAsciiAndUnicode() {
+        assertEquals("7b072c7164a1c2da9ae67f61b438e0b5f86fb6515534603a455ef5299b056df1", hx(E2ee.derive("correct horse battery", "alice")))
+        assertEquals("c9d46346f81c66652dfedd5ddd701bf512f5c409ea376d8cb1b3b2832e6939ca", hx(E2ee.derive("p\u00e4ssw\u00f6rd-\u65e5\u672c-\ud83d\ude00", "\u30e6\u30fc\u30b6\u30fc")))
+    }
+
+    @Test fun blindedIdsMatchPython() {
+        val expected = mapOf(
+            "GitHub" to "e1.bfa880457ad6a48d49db5def6d174877",
+            "Google" to "e1.24ce4466127be2a43ceea3854df3a311",
+            "Caf\u00e9 \u2713 \ud83d\ude00" to "e1.15eaa7891f0e07bc897b9dfb57d5ae93"
+        )
+        for ((name, id) in expected) assertEquals(id, E2ee.id(master, name))
+    }
+
+    @Test fun opensBlobsSealedByPython() {
+        assertArrayEquals("hello".toByteArray(), E2ee.open(master, "e1:44A7GlxuYClMu5qOqfoyaX1m6U5fLYV4xnlAjyVlU_huW9LWLonleR5lh2NKQSITAWzamzM=", "slot".toByteArray()))
+        assertNull("wrong associated data", E2ee.open(master, "e1:44A7GlxuYClMu5qOqfoyaX1m6U5fLYV4xnlAjyVlU_huW9LWLonleR5lh2NKQSITAWzamzM=", "other".toByteArray()))
